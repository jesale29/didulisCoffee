<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: 'Courier New', Courier, monospace; }
        .error-card { border: 1px solid #30363d; background: #161b22; border-radius: 8px; }
        .stack-trace { background: #010409; color: #ff7b72; padding: 1.5rem; border-radius: 4px; overflow-x: auto; font-size: 0.85rem; }
        .highlight { color: #79c0ff; }
    </style>
</head>
<body class="d-flex align-items-center min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="error-card p-5 shadow-lg">
                    <h1 class="display-5 text-danger fw-bold mb-3">
                        <i class="fas fa-exclamation-triangle"></i> System Error
                    </h1>
                    <h4 class="mb-4">Message: <span class="highlight"><%= message %></span></h4>
                    
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted">Stack Trace:</span>
                        <span class="badge bg-danger">Status: <%= status || 500 %></span>
                    </div>
                    
                    <pre class="stack-trace"><code><%= stack %></code></pre>
                    
                    <div class="mt-4">
                        <a href="/admin/dashboard" class="btn btn-outline-primary btn-sm">Return to Dashboard</a>
                        <button onclick="location.reload()" class="btn btn-outline-secondary btn-sm">Retry Request</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>