<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light display-4">Experience Didulis Coffee</h1>
            <p class="lead text-muted">From the heart of the farm to your morning cup. Managing our finest inventory with precision and passion.</p>
            <p>
                <a href="/inventory" class="btn btn-primary my-2">View Inventory</a>
                <a href="#about" class="btn btn-outline-secondary my-2">Our Story</a>
            </p>
        </div>
    </div>
</section>

<div class="py-5 bg-light" id="about">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="pb-3">About Didulis</h2>
                <p>Didulis Coffee isn't just a business; it's a legacy. We specialize in sourcing and managing premium coffee beans with a focus on sustainability and quality control.</p>
                <p>Our connected database ensures that every SKU, from <strong>XXX-ZZZ-ZZZZ</strong> to our specialty blends, is tracked from arrival to roast.</p>
            </div>
            <div class="col-md-6">
                <div class="p-5 bg-white shadow-sm rounded-3">
                    <i class="bi bi-quote display-1 text-primary"></i>
                    <p class="fst-italic">"Coffee is the common man's gold, and like gold, it brings to every person the feeling of luxury and nobility."</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5" id="contact">
    <div class="row g-5">
        <div class="col-md-5">
            <h2>Contact Us</h2>
            <p>Have questions about our inventory or wholesale opportunities?</p>
            <ul class="list-unshifted">
                <li><i class="bi bi-geo-alt me-2"></i> San Pedro Sula, Honduras</li>
                <li><i class="bi bi-envelope me-2"></i> info@diduliscoffee.com</li>
            </ul>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<% contentFor('pageScripts') %>
<script src="/js/main.js"></script>
