<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="display-1 fw-bold text-danger">500</h1>
            <h2 class="mb-4">Internal Server Error</h2>
            <p class="text-secondary mb-4">
                Something went wrong on our end. We've been notified and are looking into it.
            </p>
            
            <% if (typeof error !== 'undefined' && process.env.NODE_ENV !== 'production') { %>
                <div class="card text-start bg-light mb-4">
                    <div class="card-body">
                        <p class="card-text text-danger font-monospace small"><%= error %></p>
                    </div>
                </div>
            <% } %>

            <a href="/" class="btn btn-warning px-5 fw-bold">Return Home</a>
        </div>
    </div>
</div>