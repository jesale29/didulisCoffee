<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 fw-bold">System Overview</h1>
        <div class="d-flex gap-2">
            <button class="btn btn-primary shadow-sm btn-sm">
                <i class="fas fa-plus me-1"></i> New Report
            </button>
            <button class="btn btn-outline-secondary btn-sm bg-body shadow-sm">
                <i class="fas fa-download"></i>
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-2">
                            <i class="fas fa-coffee fa-lg"></i>
                        </div>
                        <span class="badge bg-success-subtle text-success small">+12%</span>
                    </div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Total Sales</h6>
                    <h2 class="mb-0 fw-bold">$4,250.00</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded p-2">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                        </div>
                        <span class="badge bg-danger-subtle text-danger small">-3%</span>
                    </div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Active Orders</h6>
                    <h2 class="mb-0 fw-bold">84</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2">
                            <i class="fas fa-boxes fa-lg"></i>
                        </div>
                    </div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Inventory Low</h6>
                    <h2 class="mb-0 fw-bold text-warning">12 Items</h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 text-success rounded p-2">
                            <i class="fas fa-users fa-lg"></i>
                        </div>
                    </div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Total Customers</h6>
                    <h2 class="mb-0 fw-bold">1,102</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-bottom p-3">
                    <h6 class="mb-0 fw-bold">Recent Transactions</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-body-secondary">
                                <tr>
                                    <th class="border-0 px-3 py-2 small">ORDER ID</th>
                                    <th class="border-0 px-3 py-2 small">CUSTOMER</th>
                                    <th class="border-0 px-3 py-2 small">STATUS</th>
                                    <th class="border-0 px-3 py-2 small">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                 <% if (stats.orders && stats.orders.length > 0) { %>
                                    <% stats.orders.forEach(order => { 
                                        // Using the format helper from your Order model
                                        const formatted = order.format ? order.format() : order;
                                        
                                        // Determine Badge Color
                                        let badgeClass = 'bg-secondary-subtle text-secondary';
                                        if (order.status_name === 'Confirmed') badgeClass = 'bg-success-subtle text-success';
                                        if (order.status_name === 'Reserved') badgeClass = 'bg-warning-subtle text-warning';
                                        if (order.status_name === 'Cancelled') badgeClass = 'bg-danger-subtle text-danger';
                                    %>
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">
                                                <%= formatted.orderNumber %>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-medium text-body"><%= order.user_email || 'Guest' %></span>
                                                    <small class="text-muted" style="font-size: 0.75rem;">ID: <%= order.user_id %></small>
                                                </div>
                                            </td>
                                            <td class="text-muted">
                                                <%= new Date(order.created_at).toLocaleDateString() %>
                                            </td>
                                            <td class="fw-bold text-body">
                                                $<%= parseFloat(order.total_amount).toFixed(2) %>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill <%= badgeClass %> px-3">
                                                    <%= order.status_name || 'Processing' %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/admin/orders/<%= order.id %>" class="btn btn-light btn-sm border shadow-sm">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                                            <p>No recent orders found.</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-transparent text-center border-0 py-3">
                    <a href="/admin/orders" class="small text-decoration-none">View All Transactions <i class="fas fa-chevron-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-4 text-center">
                    <i class="fas fa-rocket fa-3x mb-3 opacity-50"></i>
                    <h5 class="fw-bold">System Status</h5>
                    <p class="small opacity-75">All services are currently running within normal parameters.</p>
                    <hr class="opacity-25">
                    <div class="d-flex justify-content-between small">
                        <span>API Latency</span>
                        <span class="fw-bold">42ms</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>