<div class="row justify-content-center">
    <div class="col-md-7">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/inventory" class="text-warning text-decoration-none">Inventory</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add New Product</li>
            </ol>
        </nav>

        <div class="card shadow-lg border-0">
            <div class="card-header bg-warning py-3">
                <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-plus-circle-fill me-2"></i>New Coffee Stock</h4>
            </div>
            <div class="card-body p-4">
                <form action="/inventory" method="POST" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label for="image" class="form-label fw-bold small text-uppercase text-secondary">Product Image</label>
                        <input type="file" name="image" id="image" class="form-control" accept="image/*">
                        <div class="form-text">Upload a high-quality photo of the coffee bag or beans.</div>
                    </div>
                    <div class="mb-3">
                        <label for="sku" class="form-label fw-bold">SKU</label>
                        <div class="input-group">
                            <input type="text" name="sku" id="skuInput" class="form-control" 
                                placeholder="ABC-123-XYZ4" >
                            
                            <button class="btn btn-outline-primary" type="button" onclick="generateFormattedSku()" id="genBtn">
                                Generate SKU
                            </button>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="name" class="form-label fw-bold small text-uppercase text-secondary">Product Name</label>
                        <input type="text" name="name" id="name" class="form-control form-control-lg" 
                               placeholder="e.g., Ethiopian Yirgacheffe (Light Roast)" required autofocus>
                        <div class="form-text">Give your coffee a descriptive name for easier searching.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label for="quantity" class="form-label fw-bold small text-uppercase text-secondary">Initial Stock (Units)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input type="number" name="quantity" id="quantity" class="form-control" 
                                       min="0" value="0" required>
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label for="price" class="form-label fw-bold small text-uppercase text-secondary">Unit Price ($)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input type="number" name="price" id="price" class="form-control" 
                                       step="0.01" min="0" placeholder="0.00" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label fw-bold small text-uppercase text-secondary">Notes (Optional)</label>
                        <textarea name="description" id="description" class="form-control" rows="2" placeholder="Origin, Roast level, etc."></textarea>
                    </div>

                    <hr class="my-4 border-secondary opacity-25">

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/inventory" class="btn btn-link text-secondary text-decoration-none fw-bold">Cancel</a>
                        <button type="submit" class="btn btn-warning btn-lg px-5 fw-bold shadow-sm">
                            Save Product <i class="bi bi-check-circle-fill ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

