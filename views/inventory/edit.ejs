<div class="row justify-content-center">
    <div class="col-md-7">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/inventory" class="text-warning text-decoration-none">Inventory</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Product</li>
            </ol>
        </nav>

        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary py-3">
                <h4 class="mb-0 fw-bold text-white"><i class="bi bi-pencil-square me-2"></i>Update Product Details</h4>
            </div>
            <div class="card-body p-4">
                <form action="/inventory/<%= item.id %>" method="POST" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-secondary">Current Image</label>
                        <div class="mb-2">
                            <% if (item.image_url) { %>
                                <img src="<%= item.image_url %>" alt="Product" class="img-thumbnail" style="height: 150px;">
                            <% } else { %>
                                <div class="p-3 bg-light text-muted border d-inline-block">No image uploaded</div>
                            <% } %>
                        </div>
                        
                        <label for="image" class="form-label fw-bold small text-uppercase text-secondary">Replace Image</label>
                        <input type="file" name="image" id="image" class="form-control" accept="image/*">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-secondary">SKU / Item Code</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                            <input type="text" name="sku" class="form-control bg-light" 
                                   value="<%= item.sku %>" readonly>
                        </div>
                        <div class="form-text">SKUs cannot be changed once assigned.</div>
                    </div>

                    <div class="mb-4">
                        <label for="name" class="form-label fw-bold small text-uppercase text-secondary">Product Name</label>
                        <input type="text" name="name" id="name" class="form-control form-control-lg" 
                               value="<%= item.name %>" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label for="quantity" class="form-label fw-bold small text-uppercase text-secondary">Stock Quantity</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input type="number" name="quantity" id="quantity" class="form-control" 
                                       min="0" value="<%= item.quantity %>" required>
                            </div>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label for="price" class="form-label fw-bold small text-uppercase text-secondary">Unit Price ($)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">$</span>
                                <input type="number" name="price" id="price" class="form-control" 
                                       step="0.01" min="0" value="<%= Number(item.price).toFixed(2) %>" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label fw-bold small text-uppercase text-secondary">Notes (Optional)</label>
                        <textarea name="description" id="description" class="form-control" rows="2" placeholder="Origin, Roast level, etc."><%= item.description %></textarea>
                    </div>

                    <hr class="my-4 border-secondary opacity-25">

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/inventory" class="btn btn-link text-secondary text-decoration-none fw-bold">Discard Changes</a>
                        <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">
                            Update Product <i class="bi bi-cloud-upload ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>