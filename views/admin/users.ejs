<%- include('../partials/header') %>

<h2>User Management</h2>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.full_name %></td>
                <td>
                    <strong><%= user.roles.name.toUpperCase() %></strong>
                </td>
                <td>
                    <form action="/admin/change-role" method="POST" style="margin:0">
                        <input type="hidden" name="userId" value="<%= user.id %>">
                        <select name="newRoleId">
                            <option value="1">Admin</option>
                            <option value="2" <%= user.roles.name === 'customer' ? 'selected' : '' %>>Customer</option>
                            <option value="3">Staff</option>
                        </select>
                        <button type="submit" style="padding: 5px">Update</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../partials/footer') %>