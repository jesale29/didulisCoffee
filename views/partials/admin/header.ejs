<header class="navbar navbar-expand-lg border-bottom sticky-top bg-body shadow-sm px-4 py-2">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="/admin/dashboard" class="text-decoration-none text-secondary">
                    <i class="fas fa-home me-1"></i> Admin
                </a>
            </li>
            <li class="breadcrumb-item active fw-bold" aria-current="page">
                <%= title %>
            </li>
        </ol>
    </nav>

    <div class="ms-auto d-flex align-items-center">
        
        <span class="badge rounded-pill bg-success-subtle text-success border border-success me-3 d-none d-md-inline-block">
            <i class="fas fa-circle fa-xs me-1 pulse"></i> System Live
        </span>

        <button class="btn btn-link nav-link px-3 me-2 border-0 shadow-none" id="theme-toggle" type="button" title="Toggle Theme">
            <i class="fas fa-moon fs-5" id="theme-icon"></i>
        </button>

        <div class="vr mx-2 text-secondary opacity-25"></div>

        <div class="text-end ms-3">
            <p class="mb-0 fw-bold small line-height-1 text-body">
                <%= user.email.split('@')[0] %>
            </p>
            <p class="mb-0 text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                <%= user.role || 'Staff' %>
            </p>
        </div>

        <div class="ms-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 35px; height: 35px; font-size: 0.9rem;">
            <%= user.email.charAt(0).toUpperCase() %>
        </div>
        
    </div>
</header>