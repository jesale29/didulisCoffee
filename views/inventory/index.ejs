<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold mb-0">Coffee Inventory</h2>
        <p class="text-secondary mb-0">Manage your stock levels and pricing</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <a href="/inventory/create" class="btn btn-warning fw-bold px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Add New Product
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card border-0 shadow-sm bg-primary-subtle">
            <div class="card-body">
                <h6 class="text-uppercase small fw-bold text-primary">Total Items</h6>
                <h3 class="mb-0 fw-bold"><%= items.length %></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3 mb-md-0">
        <div class="card border-0 shadow-sm bg-warning-subtle">
            <div class="card-body">
                <h6 class="text-uppercase small fw-bold text-warning-emphasis">Low Stock Alerts</h6>
                <h3 class="mb-0 fw-bold"><%= items.filter(i => i.quantity < 10).length %></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success-subtle">
            <div class="card-body">
                <h6 class="text-uppercase small fw-bold text-success">Total Value</h6>
                <h3 class="mb-0 fw-bold">$<%= items.reduce((acc, i) => acc + (i.price * i.quantity), 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %></h3>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product Details</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; overflow: hidden;">
                                            <% if (item.image_url) { %>
                                                <img src="<%= item.image_url %>" 
                                                    alt="<%= item.name %>" 
                                                    style="width: 100%; height: 100%; object-fit: cover;">
                                            <% } else { %>
                                                <i class="bi bi-box-seam text-secondary"></i>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="fw-bold"><%= item.name %></div>
                                            <div class="small text-secondary">SKU: <%= item.sku.toString() %></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="fw-medium text-success">$<%=Number(item.price).toFixed(2) %></span></td>
                                <td><%= item.quantity %></td>
                                <td>
                                    <% if (item.quantity <= 0) { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Out of Stock</span>
                                    <% } else if (item.quantity < 10) { %>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Low Stock</span>
                                    <% } else { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Healthy</span>
                                    <% } %>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a href="/inventory/<%= item.id %>/edit" class="btn btn-sm btn-outline-secondary border-0" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form action="/inventory/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this item?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No items found in inventory.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>